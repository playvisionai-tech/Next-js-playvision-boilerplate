# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/vitest-test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# Sentry Config File
.env.sentry-build-plugin

# PGlite's local database directory, at the repo root only.
# NOT a bare `local`: that pattern matches any directory of that name at any
# depth, which silently untracks every feature's src/features/*/local/ tier.
/local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database
*.db

# storybook
storybook-static
*storybook.log
build-archive.log

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# pnpm
.pnpm-store/

# Serwist service worker build output
public/sw.js
public/sw.js.map
public/swe-worker-*.js
